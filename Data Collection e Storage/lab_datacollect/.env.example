# Copie para .env e troque os valores "change_me" antes de subir o ambiente:
#   PowerShell:   Copy-Item .env.example .env
#   Linux/macOS:  cp .env.example .env
# O .env nunca deve ser versionado.

# --- PostgreSQL (origem) ---
POSTGRES_USER=lab_admin
POSTGRES_PASSWORD=change_me
POSTGRES_DB=lab_source
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# --- CDC (usuário de replicação + publicação pgoutput) ---
CDC_USER=cdc_reader
CDC_PASSWORD=change_me
CDC_PUBLICATION=lab_cdc_pub

# --- MinIO (object storage) ---
MINIO_ROOT_USER=lab_minio_admin
# Mínimo de 8 caracteres
MINIO_ROOT_PASSWORD=change_me_please
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_BRONZE=bronze
MINIO_BUCKET_SILVER=silver
# Endpoint usado pelos scripts Python rodando no host
S3_ENDPOINT_URL=http://127.0.0.1:9000

# --- Kafka (KRaft) ---
# ID do cluster (base64 de 16 bytes). Gerar um novo:
#   docker run --rm apache/kafka:3.9.1 /opt/kafka/bin/kafka-storage.sh random-uuid
KAFKA_CLUSTER_ID=bMUpBR4BSca3hrsiTaqQuA
KAFKA_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092

# --- Kafka Connect / Debezium ---
KAFKA_CONNECT_PORT=8083
KAFKA_CONNECT_URL=http://127.0.0.1:8083

# --- Iceberg (catálogo SQLite local, warehouse no MinIO) ---
ICEBERG_CATALOG_NAME=lab
ICEBERG_CATALOG_URI=sqlite:///data/iceberg/catalog.db
ICEBERG_WAREHOUSE=s3://silver/warehouse

# --- Ambiente Python (container lab-python com Jupyter) ---
# Dentro do container, o compose sobrescreve POSTGRES_HOST, S3_ENDPOINT_URL,
# KAFKA_BOOTSTRAP_SERVERS e KAFKA_CONNECT_URL com os nomes internos da rede.
JUPYTER_PORT=8888
JUPYTER_TOKEN=change_me
